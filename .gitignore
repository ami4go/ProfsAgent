# Environment & secrets — never commit
.env
.env.*

# Python / tooling
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# Raw crawled data (too large for git)
data/raw/
data/parsed/

# Regenerable caches and logs (AI responses, embeddings, fetched pages, book lookups)
data/cache/
data/stub_build.log

# Run artefacts that are machine-local (runs/ itself IS committed)
runs/*/checkpoint.sqlite*
runs/_smoke/
# courses made in the local app (professors' ideas stay off GitHub), and its Deleted bin
runs/app-*/
runs/_deleted/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Temporary storage for references
Temporary/

# Test scripts
test_key.py
test_or.py

# Generated images (not needed in repo)
cse222_knowledge_graph.png
cse222_knowledge_graph_layered.png
ffff.jpeg
image.png

# IDE
.vscode/
.idea/

# deliverable B batch console logs (the decks and material/llm_calls.jsonl are kept)
runs/*/delivery/material/batch_*.log
# Office lock files (a deck open in PowerPoint)
~$*
runs/*/delivery/material/*/*.zip

# Simulation builds, QA screenshots and reports (made by scripts/sims.py; not committed)
simulations/_build/
# simulations professors asked for in the app (their course ideas stay off GitHub)
runs/_simulation_requests.json
# the simulation auto-build: each request's attempts and AI calls, the worker's heartbeat, the requests file's lock
runs/_simulation_builds/
runs/_simulation_autobuild.json
runs/_simulation_requests.json.lock
