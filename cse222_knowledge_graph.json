  "nodes": [
    {
      "id": "COURSE",
      "type": "Course",
      "title": "Algorithm Design & Analysis",
      "code": "CSE222",
      "credits": 4,
      "prereqs": "DSA, IP",
      "textbook": "Kleinberg & Tardos, Algorithm Design, 2006"
    },
    {
      "id": "CO1",
      "type": "CO",
      "description": "Design algorithms using greedy, divide & conquer, dynamic programming"
    },
    {
      "id": "CO2",
      "type": "CO",
      "description": "Analyze correctness and complexity of algorithms"
    },
    {
      "id": "CO3",
      "type": "CO",
      "description": "Design, analyze, and apply graph algorithms"
    },
    {
      "id": "CO4",
      "type": "CO",
      "description": "Implement algorithms for solving problems"
    },
    {
      "id": "CO5",
      "type": "CO",
      "description": "Explain NP-hardness, NP-completeness, and reductions"
    },
    {
      "id": "LO1",
      "type": "LO",
      "description": "Apply divide & conquer to design recursive algorithms",
      "bloom_level": "Apply"
    },
    {
      "id": "LO2",
      "type": "LO",
      "description": "Apply dynamic programming to optimization problems",
      "bloom_level": "Apply"
    },
    {
      "id": "LO3",
      "type": "LO",
      "description": "Apply greedy strategy to scheduling & MST problems",
      "bloom_level": "Apply"
    },
    {
      "id": "LO4",
      "type": "LO",
      "description": "Prove correctness of algorithms using loop invariants",
      "bloom_level": "Analyze"
    },
    {
      "id": "LO5",
      "type": "LO",
      "description": "Analyze time complexity using recurrences & asymptotic notation",
      "bloom_level": "Analyze"
    },
    {
      "id": "LO6",
      "type": "LO",
      "description": "Apply BFS, DFS, shortest path, and MST algorithms",
      "bloom_level": "Apply"
    },
    {
      "id": "LO7",
      "type": "LO",
      "description": "Implement algorithms in a programming language",
      "bloom_level": "Apply"
    },
    {
      "id": "LO8",
      "type": "LO",
      "description": "Explain P vs NP and perform polynomial reductions",
      "bloom_level": "Understand"
    },
