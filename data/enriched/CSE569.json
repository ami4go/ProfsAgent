    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Students will be able to identify and describe the various models of cloud computing. Students will also be able to deconstruct and justify the various building blocks of a cloud datacenter such as compute, storage and network.",
            "bloom_level": "Evaluate",
            "bloom_verb": "justify",
            "quality_score": 2,
            "quality_reasons": [
                "action_verb=justify",
                "has_object",
                "no_context"
            ]
        },
        {
            "label": "CO2",
            "raw_text": "Students will be able to explain virtualization and determine its proper applicabilty in different contexts. They will be able to appreciate and utilize concepts such as containers, docker etc. while working on cloud-based applications.",
            "bloom_level": "Understand",
            "bloom_verb": "explain",
            "quality_score": 2,
            "quality_reasons": [
                "action_verb=explain",
                "has_object",
                "no_context"
            ]
        },
        {
            "label": "CO3",
            "raw_text": "Students will be able to explain and classify various cloud storage models, file systems and databases. They will also be able to critique or justify their utility in different scenarios.",
            "bloom_level": "Evaluate",
            "bloom_verb": "critique",
            "quality_score": 2,
            "quality_reasons": [
                "action_verb=critique",
                "has_object",
                "no_context"
            ]
        },
        {
            "label": "CO4",
            "raw_text": "Students will able to design and implement cloud-based applications using techniques such as distributed programming for the cloud.",
            "bloom_level": "Create",
            "bloom_verb": "design",
            "quality_score": 3,
