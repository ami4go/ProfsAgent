    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Explain the fundamental principles of classical cryptography, including design goals, symmetric and asymmetric systems, and security models.",
            "bloom_level": "Create",
            "bloom_verb": "design",
            "quality_score": 3,
            "quality_reasons": [
                "action_verb=design",
                "has_object",
                "has_context"
            ]
        },
        {
            "label": "CO2",
            "raw_text": "Describe and analyze the working of key quantum algorithms (Simon\u2019s, Shor\u2019s, Grover\u2019s) and their computational implications.",
            "bloom_level": "Analyze",
            "bloom_verb": "analyze",
            "quality_score": 2,
            "quality_reasons": [
                "action_verb=analyze",
                "has_object",
                "no_context"
            ]
        },
        {
            "label": "CO3",
            "raw_text": "Evaluate the impact of quantum algorithms on classical cryptographic schemes such as RSA and symmetric key cryptography.",
            "bloom_level": "Evaluate",
            "bloom_verb": "evaluate",
            "quality_score": 2,
            "quality_reasons": [
                "action_verb=evaluate",
                "has_object",
                "no_context"
            ]
        },
        {
            "label": "CO4",
            "raw_text": "Apply and compare post-classical techniques such as Quantum Key Distribution (QKD) and cryptography with deletion to modern security challenges.",
            "bloom_level": "Apply",
            "bloom_verb": "apply",
            "quality_score": 2,
            "quality_reasons": [
