{
    "header": {
        "course_code": "CSE634",
        "name": "Algorithmic Techniques for Robot Planning",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "This interdisciplinary course will study applications of algorithmic techniques in robot planning focussing on motion planning, task planning and their combination. Basically, this course will explore areas that the students are familiar with -- algorithms, probability and some concepts in computational hardness etc. Technically, it will include computational challenges underlying robot planning in various settings and addressing those problems using concepts of algorithms. At the end of the course, the students will be able to appreciate the application of their known technical concepts into applications of robotics and related domains.",
