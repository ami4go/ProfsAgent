    "weekly_plan": [
        {
            "week": "1, 2",
            "lecture_topics": [
                "Introduction - Importance of semiconductor devices and their applications",
                "basics of semiconductor physics",
                "Schrodinger\u2019s equation",
                "crystal structure",
                "Bloch's theorem",
                "Free electron model",
                "energy band formation",
                "Energy dispersion relation",
                "electron-hole pair generation",
                "classification of semiconductors"
            ],
            "cos_met": [
                "CO1"
            ],
            "tutorial_assignment": "Assignment 1"
        },
        {
            "week": "3, 4, 5",
            "lecture_topics": [
                "Effective mass",
                "Density of States",
                "Intrinsic carrier density",
                "Fermi level",
                "doping and extrinsic semiconductors",
                "charge neutrality relationship",
                "Carrier transport: Diffusion current, drift current, Einstein relation, carrier scattering, mobility, velocity saturation",
                "generation and recombination of carriers (Radiative, SRH and Auger)"
            ],
            "cos_met": [
                "CO1"
            ],
            "tutorial_assignment": null
        },
        {
            "week": "6, 7, 8",
            "lecture_topics": [
                "Types of junctions (ohmic, near ohmic, rectifying)",
                "carrier injection",
                "pn junction",
                "band bending & energy band diagram",
                "pn junction electrostatics under equilibrium",
                "fixed and free charge",
                "depletion approximation",
                "electric field at the junction",
                "built-in potential",
                "quasi-Fermi levels",
                "pn junction under applied bias",
                "band-bending under applied bias",
                "Zener and avalanche breakdown"
            ],
            "cos_met": [
                "CO1",
                "CO2"
            ],
            "tutorial_assignment": "Assignment 2"
        },
        {
            "week": "9",
            "lecture_topics": [
                "Minority carrier injection and spatial variation in depletion and quasi-neutral regions",
                "depletion capacitance in pn junction",
                "ideal diode equation",
                "Diode non-idealities",
                "Schottky diode",
                "modifications of barrier potential in Schottky diode",
                "Fermi level pinning"
            ],
            "cos_met": [
                "CO1",
                "CO2"
            ],
            "tutorial_assignment": null
        },
        {
            "week": "10",
            "lecture_topics": [
                "Compound semiconductors",
                "optical absorption",
                "Solar cells - principle",
                "J-V characteristics of solar cell",
                "Shockley-Quiesser limit",
                "different types of solar cells"
            ],
            "cos_met": [
                "CO1",
                "CO3"
            ],
            "tutorial_assignment": "Assignment 3"
        },
        {
            "week": "11",
            "lecture_topics": [
                "Light emitting devices \u2013 Heterostructures",
                "LEDs and their luminescent efficiency",
                "double heterostructure and population inversion",
                "diode lasers",
                "L-I characteristics and threshold current"
            ],
            "cos_met": [
                "CO1",
                "CO3"
            ],
            "tutorial_assignment": null
        },
        {
            "week": "12, 13",
            "lecture_topics": [
                "Foundation of MOS capacitor",
                "MOSFET - working principle, I-V characteristics, pinch-off condition"
            ],
            "cos_met": [
                "CO1",
                "CO4"
            ],
            "tutorial_assignment": null
        }
