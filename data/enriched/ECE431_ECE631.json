    "weekly_plan": [
        {
            "week": "1",
            "lecture_topics": [
                "Introduction - Review of vector calculus",
                "review of Maxwells equations",
                "Materials and free space",
                "Wave propagation"
            ],
            "cos_met": [
                "CO1"
            ],
            "tutorial_assignment": "Assignment"
        },
        {
            "week": "2",
            "lecture_topics": [
                "Why do antennas radiate?",
                "Vector potential A for electric current source",
                "vector potential F for magnetic current source",
                "solution of inhomogeneous Helmholtz equation",
                "far field radiation"
            ],
            "cos_met": [
                "CO1"
            ],
            "tutorial_assignment": "Assignment"
        },
        {
            "week": "3, 4",
            "lecture_topics": [
                "Radiation pattern",
                "beamwidth",
                "directivity",
                "antenna efficiency and gain",
                "bandwidth",
                "input impedance",
                "polarization",
                "antenna effective length and effective area",
                "Friis transmission equation"
            ],
            "cos_met": [
                "CO4"
            ],
            "tutorial_assignment": "Assignment / Lab / Tutorial\nLab: Learn to use vector network analyzer to measure bandwidth"
        },
        {
            "week": "5",
            "lecture_topics": [
                "Infinitesimal, small and half wavelength dipoles",
                "effect of conductors near ground planes",
                "monopoles",
                "loop antennas"
            ],
            "cos_met": [
                "CO2"
            ],
            "tutorial_assignment": "Assignment / Lab / Tutorial"
        },
        {
            "week": "6, 7",
            "lecture_topics": [
                "Antenna arrays - Two element array, N element array, planar array",
