        "name": "Advanced Digital Design and Verification",
        "credits": "4",
        "offered_to": [
            "PG",
            "UG"
        ],
        "department": "ECE",
        "description": "This course aims to develop a basic understanding of the methods, tools, and technologies involved in designing and verifying a complex digital system. This course is intended to give an overall perspective of various tasks involved in implementing a digital system at the pre-RTL level, such as hardware-software co-design, creating abstract models, high-level synthesis, and integrating IPs for an SoC. This course also covers advanced functional and clock-domain verification methodologies. It will offer ample opportunities to employ CAD tools and gain a practical understanding of the design and verification methodologies.",
        "prerequisites_mandatory": [
            "VLSI Design Flow (ECE313/ECE513)"
        ],
        "prerequisites_desirable": [
            "C++ or Concepts of Object-oriented Programming"
        ],
        "prerequisites_mandatory_resolved": [
            "VLSI Design Flow (ECE313/ECE513)"
        ],
        "prerequisites_desirable_resolved": [
            "C++ or Concepts of Object-oriented Programming"
        ]
    },
