    "header": {
        "course_code": "ECE565",
        "aliases": [],
        "name": "Tomographic Imaging (Computerized Tomography)",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "The course introduces the topics of (a) Overview - mathematics/physics/algorithms/engineering of tomographic inversion process, ill-posed problem, ill-conditioned problem, sparse data case (b)Application of tomography-nondestructive testing, non-invasive measurements, medical imaging, network diagnostics, nuclear security and safety (c) Fundamentals - Projection data, Fourier Transform, Central Slice Theorem, Convolution backprojection, Shannon sampling, approximate Dirac-delta functionals (d) Engineering aspects: data collection methods, related instrumentation, geometric resolution, contrast resolution (e) Inversion Algorithms - Transform methods, Algebraic mehtods, Optimization techniques, sequential/parallel implementation (f) Error estimates - inherent error, discretization error, total error, direct theorem, inverse theorem, saturation theorm (g)Pitfalls in CT image interpretation - patient motion, dynamic bias, beam-hardening, Poisson effect, centre-of-rotation error, instrument noise",
        "prerequisites_mandatory": [
            "MTH100"
        ],
