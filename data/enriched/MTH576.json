    "weekly_plan": [
        {
            "week": "1, 2",
            "lecture_topics": [
                "Introduction to Categorical Response Data",
                "Probability Distributions like Binomial, Multinomial, Poisson, Negative Binomial",
                "Small and Large Sample inference"
            ],
            "cos_met": [
                "CO1",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": null
        },
        {
            "week": "2, 3, 4",
            "lecture_topics": [
                "Two, Three and k- way Contingency Tables"
            ],
            "cos_met": [
                "CO1",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": "Assignment I : On Contingency Tables"
        },
        {
            "week": "5, 6",
            "lecture_topics": [
                "Generalized Linear Models for Binary, Count and Rate data",
                "Probit and Negative Binomial regression",
                "Iteratively reweighted least squares method and Fisher's Information matrix",
                "Inferences using Wald, Score and Likelihood ratio tests"
            ],
            "cos_met": [
                "CO2",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": null
        },
        {
            "week": "7, 8, 9",
            "lecture_topics": [
                "Multiple Logistic Regression with continuous and categorical predictors and their interactions",
                "Cochran\u2013Mantel\u2013Haenszel tests",
                "Probability based and Standardized interpretaions",
                "Stepwise Variable Selection Algorithms, other criterion like AIC, BIC and AICc",
                "Derivation of deviance, goodness of fit",
                "Pearson and Standardized residuals"
            ],
            "cos_met": [
                "CO2",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": "Assignment II : On Logistic Regression"
        },
        {
            "week": "9, 10, 11",
            "lecture_topics": [
                "Multicategory Logit Models: Logit Models for Nominal Responses, Cumulative Logit Models for Ordinal Responses, Paired-Category Ordinal Logits"
            ],
            "cos_met": [
                "CO2",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": "Assignment III: On Logit models"
        },
        {
            "week": "12, 13, 14",
            "lecture_topics": [
                "Loglinear Models",
                "Independence Graphs and Collapsibility",
                "Models for Matched Pairs",
                "Generalized Beta Regression (Time permitting)"
            ],
            "cos_met": [
                "CO2",
                "CO3",
                "CO4"
            ],
            "tutorial_assignment": "Assignment IV: On Loglinear models"
        }
    ],
