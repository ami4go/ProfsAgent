            "Introduction to Psychology"
        ],
        "prerequisites_desirable_resolved": []
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Students will be able to describe the origins of the field of Social Psychology, and how this field can be differentiated from other fields of Psychology.",
            "bloom_level": "Remember",
            "bloom_verb": "describe",
