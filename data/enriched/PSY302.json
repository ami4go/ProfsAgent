            ]
        },
        {
            "label": "CO2",
            "raw_text": "Students will be able to compare and contrast several theories in terms of their ability to explain people's behaviours in various social contexts, and methods used to investigate reseach problems in Social Psychology.",
            "bloom_level": "Analyze",
            "bloom_verb": "investigate",
            "quality_score": 2,
            "quality_reasons": [
