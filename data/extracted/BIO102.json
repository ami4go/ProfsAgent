    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Students will know different types of biomolecules- their structure and function, they are able to understand fundamental cell biology processes."
        },
        {
            "label": "CO2",
            "raw_text": "Students are able to understand the biological thermodynamics, enzyme kinetics and metabolism. Students are able to solve qualitative and quantitative problems related to the same."
        },
        {
            "label": "CO3",
            "raw_text": "Students are able to understand the basics of genetics and evolution."
        },
        {
            "label": "CO4",
            "raw_text": "Students are able to understand physiology of animal and plants. They will also understand the relationships between organisms and their environment, highlighting the complex interdependence within ecosystems."
        }
