        {
            "label": "CO1",
            "raw_text": "Students are able to explain basic concepts of chemoinformatics."
        },
        {
            "label": "CO2",
            "raw_text": "Students are able to explain and implement computation of molecular descriptors and chemical similarity."
        },
        {
            "label": "CO3",
            "raw_text": "Students are able to classify small molecules and interpret results from chemoinformatics analysis."
        }
