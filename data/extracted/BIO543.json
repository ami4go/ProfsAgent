{
    "header": {
        "course_code": "BIO-BDMH",
        "aliases": [],
        "name": "Big Data Mining in Healthcare",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "One of the major challenges in the field of healthcare is extracting knowledge from the exponentially growing biomedical and clinical data. In this course, students will learn techniques for managing and mining big healthcare data. It will be broadly divided into four parts; the first part will cover various repositories or databases in the field of biomedical science. In the second part, students will be introduced to data mining techniques. Scaling data mining techniques for big data will be covered in the third phase of this course. Finally, students will learn how to solve health-related problems using a knowledge-based discovery approach..",
        "prerequisites_mandatory": [],
        "prerequisites_desirable": [
            "Basic knowledge of statistics and programming"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Student should have knowledge of major data repositories in the field of biomedical sciences."
        },
        {
            "label": "CO2",
            "raw_text": "Student should be able to manage, mine  and annotate big data"
        },
        {
            "label": "CO3",
            "raw_text": "Ability to implement datamaining techniques on large datasets"
        },
        {
            "label": "CO4",
            "raw_text": "Ability to develop prediction models for health-associated problems."
        }
    ],
