        "prerequisites_desirable": [
            "CSE111/ECE111 Digital Circuits"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Be able to explain the basic workings of a standard computer and how programs get executed."
        },
        {
            "label": "CO2",
            "raw_text": "Be able to write programs in assembly language for a given machine (e.g. ARM)"
        },
        {
            "label": "CO3",
            "raw_text": "Be able to analyze pipeline, datapath and interrupts etc."
        },
        {
            "label": "CO4",
            "raw_text": "Be able to simulate and appreciate different memory types, compare performance of cache memory, compare caches with different configuration"
        }
    ],
