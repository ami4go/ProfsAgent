        "name": "Computer Networks",
        "credits": "4",
        "offered_to": [
            "UG"
        ],
        "department": null,
        "description": "This course teaches the standard layers in network, circuit and packet switching, protocols at the link layer, routing algorithms, TCP/IP protocol, and new challenges in wireless networks.",
        "prerequisites_mandatory": [
            "CSE231"
        ],
        "prerequisites_desirable": []
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Explain the architecture of the Internet and the functions of the application, transport, network, data link, and physical layers in the TCP/IP protocol stack."
        },
        {
            "label": "CO2",
            "raw_text": "Analyze the performance and behavior of computer networks by examining protocol interactions, routing mechanisms, congestion control, and packet traces using network analysis tools."
        },
        {
            "label": "CO3",
            "raw_text": "Apply networking concepts to configure IP addressing, subnetting, routing, and develop simple client\u2013server applications using socket programming and networking tools."
        },
        {
            "label": "CO4",
            "raw_text": "Design and evaluate a secure and scalable network solution for a given application scenario by integrating appropriate protocols, technologies, and network services."
        }
    ],
