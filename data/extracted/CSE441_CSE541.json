    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "The students will get an overview of biometrics and in depth information regarding biometric modalities"
        },
        {
            "label": "CO2",
            "raw_text": "The students will be equipped with the necessary tools to design, implement and evaluate biometric systems"
        },
        {
            "label": "CO3",
            "raw_text": "The student will be able to analyze existing theories, methods and interpretation in the field of biometrics and working independently on solving theoretical and practical biometrics"
        }
