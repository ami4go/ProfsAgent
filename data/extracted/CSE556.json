        "name": "Natural Language Processing (NLP)",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "This course will cover a broad range of classical and advanced topics related to NLP, including basic text processing (such as tokenization, stemming), morphology, syntax, dependency parsing, representation learning, neural language modeling, neural information extraction, neural text clasification, and neural generative models. We will introduce and discuss various NLP tasks such as POS tagging, NER, sentiment analysis, machine translation, question answering, dialog systmes, etc. We will also introduce underlying ML and DL techniques to solve these NLP tasks such as HMM, CRF, RNNs, CNNs, attention mechanism and Tranformers. The course has a mandatory group-based project that will provide opportunity to the students to get hands-on experience on designing different real-world NLP models.",
        "prerequisites_mandatory": [
            "CSE101: Intro to Programming",
            "CSE222: Algorithm Design & Analysis",
            "MTH201: Probability and statistics",
            "ECE363/ECE563/CSE343/CSE543: Machine Learning"
        ],
        "prerequisites_desirable": []
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Understanding the advantages and disadvanatges of basic NLP techniques such as pre-procsssing, n-gram, HMMs, CFG."
        },
        {
            "label": "CO2",
            "raw_text": "Utilize and implement exisiting NLP models and analyze their performance with respect to different datasets."
        },
        {
            "label": "CO3",
            "raw_text": "Understanding the advantages and disadvanatges of Advance NLP techniques such as representation learning, seq2seq, attention meachnism, transformer, BERT, etc."
        },
        {
            "label": "CO4",
            "raw_text": "Design and implement models for advance problems by leveraging real-world datasets."
        }
    ],
