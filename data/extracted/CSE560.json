        "name": "GPU Computing",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "This course will introduce parallel computing paradigms with focus on GPGPU programming to harness the massively parallel GPU architecture in solving computationally demanding tasks. The NVIDIA CUDA and industry standard OpenCL frameworks will be introduced and used with most of the labs. This is a project based course where the students will work on scientific computational problems.",
        "prerequisites_mandatory": [
            "CSE101 Intro to Programming"
        ],
        "prerequisites_desirable": [
            "CSE102 Data Structures & Algorithms",
            "C/C++ Programming (students must know how to write reasonable length C programs before this course)."
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Students are able to understand concepts behind parallel computing"
        },
        {
            "label": "CO2",
            "raw_text": "Students are able to understand parallel computing paradigms, GPU architecture and GPGPU development frameworks (CUDA, OpenCL, and GLSL)"
        },
        {
            "label": "CO3",
            "raw_text": "Students are able to analyse an algorithms to provide parallel solutions to computationally challenging problems"
        },
        {
            "label": "CO4",
            "raw_text": "Students are able to implement such solutions on GPU using CUDA, and show  effectiveness of the GPU based solutions using standard benchmarks and tools"
        }
    ],
