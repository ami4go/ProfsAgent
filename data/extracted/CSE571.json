    "header": {
        "course_code": "CSE571",
        "aliases": [],
        "name": "Introduction to Media Computing",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": null,
        "description": "This course introduces students to:\n(i) the fundamental principles, theory, algorithms, and data structures behind digital representation, compression, synchronization, and processing of image, audio, and video data types, and\n(ii) challenges and issues in developing media-rich applications, such as media streaming and media retrieval. Students will be exposed to the workings of common media file format and common manipulation techniques on media data.",
        "prerequisites_mandatory": [],
        "prerequisites_desirable": []
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Be confident in developing software and systems that capture, generate, store, and manipulate digital media."
        },
        {
            "label": "CO2",
            "raw_text": "Be able to make appropriate design decisions to trade-off between different computation resources (CPU time, storage, bandwidth) and media quality in choosing a media representation and"
        },
        {
            "label": "CO3",
            "raw_text": "Be equipped with fundamental knowledge to pursue multimedia-related topics in depth."
        },
        {
            "label": "CO4",
            "raw_text": "Use evaluation strategies to analyze results, preparing report, and visually present the insights"
        }
    ],
