        "department": "CSE",
        "description": "This course explores the principles and design of cognitive architectures for intelligent robots. Students will engage with planning, reasoning, learning, and interaction models, drawing from AI and bio-inspired approaches. Emphasis is placed on applying theoretical concepts to real-world challenges such as task-motion integration and human-robot collaboration. Through projects and assignments, learners will gain hands-on experience in building intelligent robotic behaviors.",
        "prerequisites_mandatory": [
            "CSE643",
            "CSE101"
        ],
        "prerequisites_desirable": [
            "ECE363",
            "ECE563",
            "CSE343",
            "543",
            "CSE633",
            "ECE670"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Understand foundational concepts in robot cognition and cognitive models"
        },
        {
            "label": "CO2",
            "raw_text": "Design and model cognitive robot architectures using UML and design patterns"
        },
        {
            "label": "CO3",
            "raw_text": "Apply AI methods such as planning, search, and learning to robotic tasks"
        },
        {
            "label": "CO4",
            "raw_text": "Analyze and evaluate robot architectures for human-robot collaboration"
        },
        {
            "label": "CO5",
            "raw_text": "Handle real-world challenges such as uncertainty and task-motion integration"
        }
    ],
