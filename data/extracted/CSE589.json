{
    "header": {
        "course_code": "CSE589",
        "aliases": [],
        "name": "Large Deep Learning Systems",
        "credits": "4",
        "offered_to": [
            "Btech 3rd/4th year",
            "M.tech.",
            "Ph.D."
        ],
        "department": null,
        "description": "Recent progress in Artificial Intelligence has been driven primarily by advances in large deep learning models such as large language models (LLMs) and other generative methods. These are often very large and are trained on massive data. Developing scalable systems for such models is critical to advancements in AI. This course aims to train students to be able to code and optimize the entire pipeline of a large deep learning system such as a large language model. The course will prepare students to develop a sizeable deep learning or foundation model for generative AI with a deeper understanding of tools, patterns, and components. The course will cover the systems, tools, and methods related to the development and deployment of the model.",
        "prerequisites_mandatory": [
            "Machine Learning and Deep Learning/NLP"
        ],
        "prerequisites_desirable": []
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "To be able to decide on relevant tools/services and work with them in the development of a large deep learning system."
        },
        {
            "label": "CO2",
            "raw_text": "To be able to plan to build a large model based on the latest advances in systems in deep learning and system research."
        },
        {
            "label": "CO3",
            "raw_text": "To be able to correlate and contrast deep learning model systems based on scalability, systems resources, and user requirements."
        },
        {
            "label": "CO4",
            "raw_text": "To be able to deploy a large-scale deep learning system."
        }
    ],
