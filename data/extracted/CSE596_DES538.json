{
    "header": {
        "course_code": "CSE596",
        "aliases": [],
        "name": "Robot Perception and Manipulation",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": "CSE",
        "description": "This course explores the integration of robotic perception and manipulation, focusing on how robots sense, interpret, and physically interact with their environments. Students will study a combination of computer vision, tactile sensing, motion planning, and control techniques that enable intelligent, autonomous manipulation. The curriculum blends theoretical principles from kinematics, dynamics, and control with applied topics such as grasp planning, visual servoing, and learning-based manipulation. Emphasis is placed on developing perception-informed control strategies for real-world tasks in industrial, service, and assistive robotics.",
        "prerequisites_mandatory": [
            "CSE633/ECE670"
        ],
        "prerequisites_desirable": [
            "CSE344/CSE544/ECE344/ECE544"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Explain the principles of robotic perception and its role in manipulation tasks."
        },
        {
            "label": "CO2",
            "raw_text": "Apply computer vision algorithms for object recognition, pose estimation, and 3D perception."
        },
        {
            "label": "CO3",
            "raw_text": "Model and analyze manipulator kinematics and dynamics for control and planning."
        },
        {
            "label": "CO4",
            "raw_text": "Develop motion planning and trajectory generation algorithms for grasping and manipulation."
        },
        {
            "label": "CO5",
            "raw_text": "Integrate and implement multimodal sensing \u2014 including visual and tactile inputs \u2014 to design perception-driven manipulation systems in simulation or hardware."
        }
    ],
