        "name": "High-Dimensional Statistics and Optimization",
        "credits": "4",
        "offered_to": [
            "PG"
        ],
        "department": null,
        "description": "This course introduces the theoretical and algorithmic foundations of high-dimensional statistics with a focus on applications to deep learning and large language models. It emphasizes non-asymptotic analysis, optimization behavior in high dimensions, and phenomena unique to overparameterized models. Students will explore concentration inequalities, random matrix theory, and optimization landscapes through both mathematical rigor and hands-on experiments.",
        "prerequisites_mandatory": [
            "Linear Algebra (MTH 100)",
            "Probability and Statistics (MTH 201)",
            "Machine Learning (ECE363/ECE563/CSE343/543 or ECE666 / CSE517)"
        ],
        "prerequisites_desirable": [
            "Convex Optimization",
            "Statistical Learning Theory"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Understand the importance of HD stats in ML/LLMs. Should should be able to Describe key inequalities and use cases"
        },
        {
            "label": "CO2",
            "raw_text": "Students should be able to apply Wigner's and MP laws to deep nets and use Use JL Lemma to evaluate generalization. Compare flat vs sharp regions using NTK"
        },
        {
            "label": "CO3",
            "raw_text": "Interpret double descent & complexity and Explain SGD's regularization behavior. Understand optimisation algorithms"
        },
        {
            "label": "CO4",
            "raw_text": "Identify problem settings in high dimesional data case where the data point dimension and number of points are of similar size. Analyse such settings and implement appropriate measures to mitigate issues arising from above."
        }
    ],
