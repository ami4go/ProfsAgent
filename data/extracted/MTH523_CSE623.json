        "name": "Probabilistic Methods in Combinatorics",
        "credits": "4",
        "offered_to": [
            "UG",
            "PG"
        ],
        "department": "Math",
        "description": "The probabilistic method is a technique to prove the existence of a combinatorial object without explicitly constructing it. This powerful method is an indispensible tool in combinatorics, discrete mathematics, and allid areas such as number theory. This course aims to intoduce the probabilistic method, develop basic tools and see several applications of the techniques in several areas of mathematics and computer science.",
        "prerequisites_mandatory": [
            "Discrete Structures/Discrete Mathematics",
            "ADA/Graduate Algorithms"
        ],
        "prerequisites_desirable": [
            "Probability and Random Processes",
            "Randomized Algorithms",
            "Graph Theory"
        ]
    },
    "outcomes": [
        {
            "label": "CO1",
            "raw_text": "Students are able to apply the first moment method to problems in discrete math and computer science"
        },
        {
            "label": "CO2",
            "raw_text": "Students are able to apply tools such as the second moment method and lovasz local lemma to problems in computer science and discrete math."
        },
        {
            "label": "CO3",
            "raw_text": "Students are able to apply the probabilistic method to study questions about random combinatorial objects such as random graphs."
        },
        {
            "label": "CO4",
            "raw_text": "Students are able to apply advanced tools such as martingales to problems in computer science and combinatorics"
        }
    ],
