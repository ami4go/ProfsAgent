  "department": null,
  "description": "At a period when inequality is on the rise globally, this course is aimed at conceptually and empirically understanding what inequality is and how systems of inequality reproduce. With a focus on examining manifestations of inequality , the social and historical nature of inequality is unpacked. Rooted in a sociological perspective, the course examines contemporary social faultlines and its impact on everyday social life.",
  "prerequisites_mandatory": [],
  "prerequisites_desirable": [
   "Introduction to Sociology and Anthropology (SOC 101)",
   "Contemporary Indian Society (SOC 202)",
   "Sociological Theory (SOC 210)"
  ]
 },
 "outcomes": [
  {
   "label": "CO1",
   "raw_text": "Students can identify basic concepts in the sociology of inequality and stratification"
  },
  {
   "label": "CO2",
   "raw_text": "Students can explain how inequality shapes social life"
  },
  {
   "label": "CO3",
   "raw_text": "Students can analyse how inequality impacts social realities including development and use of technologies"
  },
  {
   "label": "CO4",
   "raw_text": "Students can evaluate and develop perspectives on inequality"
  }
 ],
