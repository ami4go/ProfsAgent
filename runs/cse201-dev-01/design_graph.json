  "P-CSE201-DEV/CCO.short_description": {
   "uid": "P-CSE201-DEV/CCO.short_description",
   "local_id": "CCO.short_description",
   "label": "ContextField",
   "props": {
    "status": "given",
    "raw": "A second programming course that moves students from writing small single-file programs to building larger applications made of several components with clear interfaces. Students learn object-oriented design, how to write code that others can reuse and test, how to structure programs around established design patterns, and how to handle errors, input/output and concurrency. By the end, students working in pairs can take a reasonably well-specified application design and deliver a working, tested, multi-component program. Java is the vehicle, but the course is about program design, not the Java language.",
    "value": "A second programming course that moves students from writing small single-file programs to building larger applications made of several components with clear interfaces. Students learn object-oriented design, how to write code that others can reuse and test, how to structure programs around established design patterns, and how to handle errors, input/output and concurrency. By the end, students working in pairs can take a reasonably well-specified application design and deliver a working, tested, multi-component program. Java is the vehicle, but the course is about program design, not the Java language."
   },
   "version": 1,
   "status": "draft",
   "created_by": "G1",
   "prompt_id": "G1",
   "prompt_version": null,
   "model": null,
   "sources": [
    {
     "tag": "USER",
     "ref": "CCO.short_description"
    }
   ],
   "ts": 1790770974.812611
